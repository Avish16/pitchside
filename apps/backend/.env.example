# Provider keys live only in this file. Copy to apps/backend/.env.
# The desktop app never sees these values. It uses PITCHSIDE_DEV_TOKEN
# to call this backend, which then talks to Deepgram and the model.

PITCHSIDE_DEV_TOKEN=pitchside-dev
PORT=43124

# anthropic (default when ANTHROPIC_API_KEY is set) or openrouter
PITCHSIDE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Live answers use a fast Haiku-class model. Deep answers and post-call
# summaries use the top Opus model. Triage fallback uses Haiku.
PITCHSIDE_FAST_MODEL=claude-haiku-5-5
PITCHSIDE_DEEP_MODEL=claude-opus-5-5
PITCHSIDE_TRIAGE_MODEL=claude-haiku-5-5

DEEPGRAM_API_KEY=
