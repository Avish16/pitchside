# Provider keys live only in this file. Copy to apps/backend/.env.
# The desktop app never sees these values. It uses PITCHSIDE_DEV_TOKEN
# to call this backend, which then talks to Deepgram and the model.

PITCHSIDE_DEV_TOKEN=pitchside-dev
PORT=43124

# xai (default), anthropic, or openrouter.
# LLM_PROVIDER wins over PITCHSIDE_PROVIDER when both are set.
LLM_PROVIDER=xai
XAI_API_KEY=

# Leave these blank unless you switch LLM_PROVIDER.
# PITCHSIDE_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Live answers and triage use the fast public Grok model (grok-4.3).
# Deep answers and post-call summaries use the strongest public model (grok-4.7).
# Change these ids if LLM_PROVIDER is anthropic or openrouter.
PITCHSIDE_FAST_MODEL=grok-4.3
PITCHSIDE_TRIAGE_MODEL=grok-4.3
PITCHSIDE_DEEP_MODEL=grok-4.7

DEEPGRAM_API_KEY=
